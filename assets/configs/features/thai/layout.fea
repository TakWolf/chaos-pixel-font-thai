feature ccmp {
  sub u0E0D' @BelowMarks by u0E0D.low;
  sub u0E0E' @BelowMarks by u0E0E.short;
  sub u0E0E.short @BelowMarks' by @BelowMarksSmall;
  sub u0E0F' @BelowMarks by u0E0F.short;
  sub u0E0F.short @BelowMarks' by @BelowMarksSmall;
  sub u0E10' @BelowMarks by u0E10.low;
  sub @ShortBases' @AboveVowels by @ShortBasesShort;
  sub @ShortBases' @Tones by @ShortBasesShort;
  sub @TallBases @AboveVowels' by @AboveVowelsNarrow;
  sub @TallBases @Tones' by @TonesNarrow;
  sub @TallBases @BelowMarks @Tones' by @TonesNarrow;
  sub @AboveVowels @Tones' by @TonesSmall;
  sub @AboveVowelsNarrow @Tones' by @TonesSmall;
} ccmp;

